{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "bootstrap-installer": {
      "root": "apps/bootstrap-installer",
      "framework": "vite"
    },
    "src-tauri": {
      "root": "apps/bootstrap-installer/src-tauri",
      "runtime": "rust"
    },
    "desktop": {
      "root": "apps/desktop",
      "framework": "vite"
    },
    "dcf-model": {
      "root": "optional-skills/finance/dcf-model",
      "runtime": "python"
    },
    "pm": {
      "root": "pm",
      "runtime": "python"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    },
    "website": {
      "root": "website",
      "framework": "docusaurus-2"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
